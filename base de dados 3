-- ============================================================
-- 19. TRANSACOES
-- ============================================================

-- Uma transacao agrupa varias operacoes.
-- Permite confirmar ou desfazer as alteracoes.
--
-- BEGIN TRANSACTION inicia uma transacao.
-- COMMIT confirma as alteracoes.
-- ROLLBACK desfaz as alteracoes.


-- EXEMPLO COM COMMIT

BEGIN TRANSACTION;

UPDATE Futebol.Jogador
SET SALARIO = 55000
WHERE IDJOGADOR = 1;

COMMIT;


-- EXEMPLO COM ROLLBACK

BEGIN TRANSACTION;

UPDATE Futebol.Jogador
SET SALARIO = 99999
WHERE IDJOGADOR = 1;

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR = 1;

ROLLBACK;


-- O salario volta ao valor anterior.

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR = 1;


-- TRANSACAO COM VARIAS OPERACOES

BEGIN TRANSACTION;

UPDATE Futebol.Jogador
SET SALARIO = SALARIO - 1000
WHERE IDJOGADOR = 1;

UPDATE Futebol.Jogador
SET SALARIO = SALARIO + 1000
WHERE IDJOGADOR = 2;

COMMIT;


-- ACID:
--
-- Atomicity:
-- Todas as operacoes sao realizadas ou desfeitas.
--
-- Consistency:
-- A transacao deve preservar a consistencia dos dados.
--
-- Isolation:
-- Controla a interferencia entre transacoes concorrentes.
--
-- Durability:
-- Alteracoes confirmadas permanecem guardadas.


-- SAVE TRANSACTION
-- Permite criar um ponto de recuperacao.

BEGIN TRANSACTION;

UPDATE Futebol.Jogador
SET SALARIO = SALARIO + 100
WHERE IDJOGADOR = 1;

SAVE TRANSACTION Ponto1;

UPDATE Futebol.Jogador
SET SALARIO = SALARIO + 500
WHERE IDJOGADOR = 2;

ROLLBACK TRANSACTION Ponto1;

COMMIT;


-- A primeira alteracao permanece.
-- A segunda alteracao e desfeita.


-- ============================================================
-- 20. TRY E CATCH
-- ============================================================

-- TRY executa instrucoes que podem provocar erros.
-- CATCH trata os erros capturados no TRY.


BEGIN TRY

    SELECT 10 / 0 AS RESULTADO;

END TRY
BEGIN CATCH

    PRINT 'Ocorreu um erro';

END CATCH;

GO


-- FUNCOES DE ERRO
--
-- ERROR_NUMBER(): Numero do erro.
-- ERROR_MESSAGE(): Mensagem do erro.
-- ERROR_LINE(): Linha do erro.
-- ERROR_SEVERITY(): Gravidade do erro.
-- ERROR_STATE(): Estado do erro.
-- ERROR_PROCEDURE(): Procedimento ou trigger do erro.


BEGIN TRY

    SELECT 10 / 0 AS RESULTADO;

END TRY
BEGIN CATCH

    SELECT
        ERROR_NUMBER() AS NUMERO,
        ERROR_MESSAGE() AS MENSAGEM,
        ERROR_LINE() AS LINHA,
        ERROR_SEVERITY() AS GRAVIDADE,
        ERROR_STATE() AS ESTADO,
        ERROR_PROCEDURE() AS PROCEDIMENTO;

END CATCH;

GO


-- CONSTRUIR MENSAGEM PERSONALIZADA

BEGIN TRY

    SELECT 10 / 0 AS RESULTADO;

END TRY
BEGIN CATCH

    SELECT
        'Erro ' +
        CAST(ERROR_NUMBER() AS VARCHAR(10)) +
        ' na linha ' +
        CAST(ERROR_LINE() AS VARCHAR(10)) +
        ': ' +
        ERROR_MESSAGE() AS ERRO;

END CATCH;

GO


-- TRY e CATCH devem estar no mesmo batch.
-- Nao colocar GO entre TRY e CATCH.
-- Nem todos os tipos de erro sao capturados pelo TRY CATCH.


