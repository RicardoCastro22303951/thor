-- ============================================================
-- 34. TRIGGER DE HISTORICO
-- ============================================================

-- Quando um jogador muda de clube,
-- guardar automaticamente os seus dados antigos.
--
-- Utilizar DELETED para recuperar os dados anteriores.
-- Utilizar INSERTED para recuperar os novos dados.
--
-- A data de inicio do novo contrato deve ser
-- atualizada na mesma instrucao que muda o clube.


GO

CREATE TRIGGER Futebol.trg_HistoricoClube
ON Futebol.Jogador
AFTER UPDATE
AS
BEGIN

    SET NOCOUNT ON;

    INSERT INTO Futebol.Historico
        (IDJOGADOR, IDCLUBE, SALARIO, DATAINICIO, DATAFIM)
    SELECT
        D.IDJOGADOR,
        D.IDCLUBE,
        D.SALARIO,
        D.DATAINICIO,
        I.DATAINICIO
    FROM deleted AS D
    INNER JOIN inserted AS I
    ON D.IDJOGADOR = I.IDJOGADOR
    WHERE
        D.IDCLUBE <> I.IDCLUBE
        OR (
            D.IDCLUBE IS NULL
            AND I.IDCLUBE IS NOT NULL
        )
        OR (
            D.IDCLUBE IS NOT NULL
            AND I.IDCLUBE IS NULL
        );

END;

GO


