-- 12. VIEWS
-- GitBook: Lesson 05 - Views
-- ============================================================

-- Uma VIEW e uma consulta guardada na base de dados.
-- Pode ser consultada como uma tabela.
-- Normalmente nao guarda uma copia dos dados.
-- CREATE VIEW deve iniciar um batch.


GO

CREATE VIEW Futebol.vw_HistoricoCompleto
AS

SELECT
    J.IDJOGADOR,
    J.NOME,
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = J.IDCLUBE
    ) AS CLUBE,
    J.SALARIO,
    J.DATAINICIO,
    'Atual' AS DATAFIM
FROM Futebol.Jogador AS J

UNION ALL

SELECT
    H.IDJOGADOR,
    (
        SELECT J.NOME
        FROM Futebol.Jogador AS J
        WHERE J.IDJOGADOR = H.IDJOGADOR
    ),
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = H.IDCLUBE
    ),
    H.SALARIO,
    H.DATAINICIO,
    CAST(H.DATAFIM AS VARCHAR(12))
FROM Futebol.Historico AS H;

GO


-- CONSULTAR VIEW

SELECT *
FROM Futebol.vw_HistoricoCompleto;


-- CONSULTAR VIEW COM FILTRO

SELECT *
FROM Futebol.vw_HistoricoCompleto
WHERE IDJOGADOR = 1
ORDER BY DATAINICIO DESC;


-- ALTERAR VIEW

GO

