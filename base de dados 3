-- 14. VARIAVEIS
-- T-SQL
-- ============================================================

-- DECLARE cria uma variavel.
-- As variaveis locais comecam por @.


-- DECLARAR VARIAVEL

DECLARE @Numero INT;


-- ATRIBUIR VALOR

SET @Numero = 10;


-- APRESENTAR VALOR

SELECT @Numero AS NUMERO;

PRINT @Numero;

GO


-- DECLARAR E INICIALIZAR

DECLARE @Nome VARCHAR(100) = 'Ronaldo';

SELECT @Nome AS NOME;

GO


-- DECLARAR VARIAS VARIAVEIS

DECLARE
    @ID INT = 1,
    @Salario DECIMAL(10,2),
    @Clube INT;

SELECT
    @Salario = SALARIO,
    @Clube = IDCLUBE
FROM Futebol.Jogador
WHERE IDJOGADOR = @ID;

SELECT
    @Salario AS SALARIO,
    @Clube AS CLUBE;

GO


-- ATRIBUIR RESULTADO DE UMA SUBQUERY

DECLARE @Total INT;

SET @Total = (
    SELECT COUNT(*)
    FROM Futebol.Jogador
);

SELECT @Total AS TOTAL;

GO


-- UTILIZAR VARIAVEL NUM WHERE

DECLARE @ID INT = 2;

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR = @ID;

GO


-- UTILIZAR VARIAVEL NUM UPDATE

DECLARE @ID INT = 1;
DECLARE @NovoSalario DECIMAL(10,2) = 55000;

UPDATE Futebol.Jogador
SET SALARIO = @NovoSalario
WHERE IDJOGADOR = @ID;

GO


-- DIFERENCA ENTRE SET E SELECT
