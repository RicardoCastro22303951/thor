-- ============================================================
-- 02. INNER JOIN E LEFT JOIN
-- GitBook: Lesson 08 - Horizontal join syntax
-- ============================================================

-- INNER JOIN:
-- Apenas registos com correspondencia nas duas tabelas.

SELECT
    J.NOME,
    C.NOME AS CLUBE,
    J.SALARIO
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Clube AS C
ON J.IDCLUBE = C.IDCLUBE;


-- LEFT JOIN:
-- Todos os registos da tabela esquerda.

SELECT
    J.NOME,
    C.NOME AS CLUBE,
    J.SALARIO
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Clube AS C
ON J.IDCLUBE = C.IDCLUBE;


-- LISTAR TODOS OS JOGADORES E O RESPETIVO HISTORICO

SELECT *
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR;


-- LISTAR APENAS JOGADORES SEM HISTORICO

SELECT J.*
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR
WHERE H.IDHISTORICO IS NULL;


-- LISTAR APENAS JOGADORES COM HISTORICO

SELECT DISTINCT J.*
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR;


-- JOIN COM VARIAS TABELAS

SELECT
    J.NOME AS JOGADOR,
    C.NOME AS CLUBE_ANTERIOR,
    H.SALARIO,
    H.DATAINICIO,
    H.DATAFIM
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR
LEFT JOIN Futebol.Clube AS C
ON H.IDCLUBE = C.IDCLUBE;


-- ============================================================
-- 03. FUNCOES DE AGREGACAO
-- GitBook: Lesson 04 - GROUP FUNCTIONS AND SET OPERATORS
-- ============================================================

-- CONTAR TODOS OS JOGADORES

SELECT COUNT(*)
FROM Futebol.Jogador;


-- CONTAR TODOS OS REGISTOS DE HISTORICO

SELECT COUNT(*)
FROM Futebol.Historico;


-- CONTAR JOGADORES DIFERENTES COM HISTORICO

SELECT COUNT(DISTINCT IDJOGADOR)
FROM Futebol.Historico;


-- CONTAR REGISTOS DE HISTORICO POR JOGADOR

SELECT
    IDJOGADOR,
    COUNT(*) AS TOTAL
FROM Futebol.Historico
GROUP BY IDJOGADOR;


-- CONTAR HISTORICO INCLUINDO JOGADORES SEM HISTORICO

SELECT
    J.IDJOGADOR,
    J.NOME,
    COUNT(H.IDHISTORICO) AS TOTAL
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR
GROUP BY J.IDJOGADOR, J.NOME;


-- SUM: SOMA

SELECT SUM(SALARIO)
FROM Futebol.Jogador;


-- AVG: MEDIA

SELECT AVG(SALARIO)
FROM Futebol.Jogador;


-- MAX: MAIOR VALOR

SELECT MAX(SALARIO)
FROM Futebol.Jogador;


-- MIN: MENOR VALOR

SELECT MIN(SALARIO)
FROM Futebol.Jogador;


-- HAVING: FILTRAR GRUPOS

SELECT
    IDJOGADOR,
    COUNT(*) AS TOTAL
FROM Futebol.Historico
GROUP BY IDJOGADOR
HAVING COUNT(*) > 1;


-- WHERE filtra registos.
-- HAVING filtra grupos.
-- COUNT(*) conta todas as linhas.
-- COUNT(coluna) ignora valores NULL.
-- COUNT(DISTINCT coluna) conta valores diferentes nao nulos.


-- ============================================================
-- 04. SUBQUERIES
-- GitBook: Lesson 08 - JOIN vs. Nested queries
-- ============================================================

-- Uma subquery e uma consulta dentro de outra consulta.
-- Pode aparecer no SELECT, FROM ou WHERE.


-- JOGADORES COM HISTORICO SEM UTILIZAR JOIN

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR IN (
    SELECT IDJOGADOR
    FROM Futebol.Historico
);


-- JOGADORES SEM HISTORICO SEM UTILIZAR JOIN

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR NOT IN (
    SELECT IDJOGADOR
    FROM Futebol.Historico
);


-- NOT IN pode produzir resultados inesperados
-- se a subquery devolver valores NULL.


-- JOGADORES COM SALARIO SUPERIOR A MEDIA

SELECT *
FROM Futebol.Jogador
WHERE SALARIO > (
    SELECT AVG(SALARIO)
    FROM Futebol.Jogador
);


-- JOGADORES COM O MAIOR SALARIO

SELECT *
FROM Futebol.Jogador
WHERE SALARIO = (
    SELECT MAX(SALARIO)
    FROM Futebol.Jogador
);


-- SUBQUERY NO FROM
-- A tabela derivada deve possuir um alias.

SELECT *
FROM (
    SELECT
        IDCLUBE,
        AVG(SALARIO) AS MEDIA
    FROM Futebol.Jogador
    GROUP BY IDCLUBE
) AS RESULTADO
WHERE MEDIA > 30000;


-- ============================================================
-- 05. SUBQUERIES CORRELACIONADAS
-- ============================================================

-- Uma subquery correlacionada utiliza valores
-- da consulta exterior.


-- OBTER NOME DO CLUBE SEM UTILIZAR JOIN

SELECT
    J.NOME,
    J.SALARIO,
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = J.IDCLUBE
    ) AS CLUBE
FROM Futebol.Jogador AS J;


-- Uma subquery escalar deve devolver no maximo uma linha.
-- Se nao devolver nenhuma linha, o resultado e NULL.


-- OBTER QUANTIDADE DE REGISTOS DE HISTORICO POR JOGADOR

SELECT
    J.NOME,
    (
        SELECT COUNT(*)
        FROM Futebol.Historico AS H
        WHERE H.IDJOGADOR = J.IDJOGADOR
    ) AS TOTAL_HISTORICO
FROM Futebol.Jogador AS J;


-- OBTER CLUBE ATUAL E CLUBE ANTERIOR

SELECT
    J.IDJOGADOR,
    J.NOME,
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = J.IDCLUBE
    ) AS CLUBE_ATUAL,
    J.DATAINICIO AS INICIO_ATUAL,
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = H.IDCLUBE
    ) AS CLUBE_ANTERIOR,
    H.DATAINICIO AS INICIO_ANTERIOR,
    H.DATAFIM AS FIM_ANTERIOR
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR
ORDER BY J.NOME, H.DATAINICIO DESC;


-- OBTER APENAS O ULTIMO CLUBE ANTERIOR

SELECT
    J.NOME,
    (
        SELECT TOP (1) C.NOME
        FROM Futebol.Historico AS H
        LEFT JOIN Futebol.Clube AS C
        ON H.IDCLUBE = C.IDCLUBE
        WHERE H.IDJOGADOR = J.IDJOGADOR
        ORDER BY H.DATAFIM DESC, H.IDHISTORICO DESC
    ) AS ULTIMO_CLUBE
FROM Futebol.Jogador AS J;


-- ============================================================
-- 06. EXISTS E NOT EXISTS
-- ============================================================

-- EXISTS verifica se a subquery devolve algum registo.
-- NOT EXISTS verifica se nao devolve nenhum registo.


-- JOGADORES COM HISTORICO

SELECT *
FROM Futebol.Jogador AS J
WHERE EXISTS (
    SELECT 1
    FROM Futebol.Historico AS H
    WHERE H.IDJOGADOR = J.IDJOGADOR
);


-- JOGADORES SEM HISTORICO

SELECT *
FROM Futebol.Jogador AS J
WHERE NOT EXISTS (
    SELECT 1
    FROM Futebol.Historico AS H
    WHERE H.IDJOGADOR = J.IDJOGADOR
);


-- CLUBES SEM JOGADORES

SELECT *
FROM Futebol.Clube AS C
WHERE NOT EXISTS (
    SELECT 1
    FROM Futebol.Jogador AS J
    WHERE J.IDCLUBE = C.IDCLUBE
);


-- ============================================================
-- 07. ISNULL E COALESCE
-- ============================================================

-- ISNULL substitui um valor NULL por outro valor.
-- ISNULL(valor, substituicao)


-- SUBSTITUIR CLUBE NULL POR TEXTO

SELECT
    J.NOME,
    ISNULL(C.NOME, 'Sem clube') AS CLUBE
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Clube AS C
ON J.IDCLUBE = C.IDCLUBE;


-- UTILIZAR DATA DE HISTORICO OU DATA ATUAL DO CONTRATO

SELECT
    J.NOME,
    ISNULL(H.DATAINICIO, J.DATAINICIO) AS DATAINICIO
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Historico AS H
ON J.IDJOGADOR = H.IDJOGADOR;


-- COALESCE devolve o primeiro valor nao nulo.
-- Pode receber mais de dois argumentos.

SELECT COALESCE(NULL, NULL, 'Texto');


-- ISNULL aceita dois argumentos.
-- COALESCE aceita varios argumentos.


-- ============================================================
-- 08. CONCAT, CAST E CONVERT
-- ============================================================

-- CONCAT junta varios valores numa string.

SELECT CONCAT('Cristiano', ' ', 'Ronaldo');


-- CONCATENAR COLUNAS

SELECT
    CONCAT(J.NOME, ' - ', C.NOME) AS DESCRICAO
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Clube AS C
ON J.IDCLUBE = C.IDCLUBE;


-- CONCATENACAO COM +

SELECT 'Cristiano' + ' ' + 'Ronaldo';


-- CONCAT trata NULL como texto vazio.
-- A concatenacao com + pode devolver NULL.


-- CAST converte um valor para outro tipo.

SELECT CAST(100 AS VARCHAR(10));

SELECT CAST('2024-07-01' AS DATE);

SELECT CAST(GETDATE() AS DATE);


-- CONCATENAR TEXTO E NUMEROS

SELECT
    'Salario: ' + CAST(SALARIO AS VARCHAR(20))
FROM Futebol.Jogador;


-- CONVERT tambem converte tipos de dados.

SELECT CONVERT(VARCHAR(10), GETDATE(), 23);


-- Estilo 23: YYYY-MM-DD.
-- Estilo 103: DD/MM/YYYY.

SELECT CONVERT(VARCHAR(10), GETDATE(), 103);


-- TRY_CAST devolve NULL se a conversao falhar,
-- desde que a conversao seja permitida entre os tipos.

SELECT TRY_CAST('ABC' AS INT);


