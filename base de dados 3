-- ============================================================
-- 42. ERROS COMUNS
-- ============================================================

-- 01. Confundir INNER JOIN com LEFT JOIN.
--
-- INNER JOIN conserva correspondencias.
-- LEFT JOIN conserva todos os registos da esquerda.


-- 02. Utilizar = NULL.
--
-- ERRADO:
-- WHERE Coluna = NULL
--
-- CERTO:
-- WHERE Coluna IS NULL


-- 03. Utilizar NOT IN quando a subquery devolve NULL.
--
-- Preferir NOT EXISTS quando existem valores nulos.


-- 04. Uma subquery escalar devolver varias linhas.
--
-- Garantir unicidade ou utilizar uma agregacao.
-- TOP (1) com ORDER BY quando se pretende um registo
-- especifico, como o mais recente.


-- 05. Utilizar COUNT(*) num LEFT JOIN quando se pretende
-- contar apenas os registos correspondentes.
--
-- Utilizar COUNT(B.ID).


-- 06. Utilizar UNION com numeros de colunas diferentes.
--
-- As consultas devem devolver o mesmo numero de colunas.


-- 07. Utilizar UNION com tipos de dados incompativeis.
--
-- Utilizar CAST ou CONVERT quando necessario.


-- 08. Confundir UNION com UNION ALL.
--
-- UNION elimina duplicados.
-- UNION ALL conserva duplicados.


-- 09. Colocar ORDER BY antes de UNION.
--
-- Normalmente ORDER BY aparece apenas no final.


-- 10. Colocar ORDER BY diretamente numa VIEW normal.
--
-- Ordenar quando se consulta a VIEW.


-- 11. Esquecer GO antes de CREATE VIEW,
-- CREATE FUNCTION, CREATE PROCEDURE ou CREATE TRIGGER.


-- 12. Utilizar uma variavel depois de GO.
--
-- A variavel deixa de existir apos o batch.


-- 13. Esquecer SET ao atribuir valores.
--
-- SET @Variavel = 10;


-- 14. Esquecer BEGIN e END quando IF ou WHILE
-- deve executar varias instrucoes.


