-- ============================================================
-- 39. CROSS APPLY E OUTER APPLY
-- GitBook: Lesson 08 - Horizontal join syntax
-- ============================================================

-- APPLY permite que uma expressao do lado direito
-- utilize valores da tabela do lado esquerdo.


-- CROSS APPLY:
-- Apenas conserva registos para os quais
-- a expressao direita devolve resultados.

SELECT
    J.NOME,
    H.IDCLUBE,
    H.DATAFIM
FROM Futebol.Jogador AS J
CROSS APPLY (
    SELECT TOP (1)
        IDCLUBE,
        DATAFIM
    FROM Futebol.Historico
    WHERE IDJOGADOR = J.IDJOGADOR
    ORDER BY DATAFIM DESC, IDHISTORICO DESC
) AS H;


-- OUTER APPLY:
-- Conserva todos os registos da tabela esquerda.
-- Quando nao existe resultado, apresenta NULL.

SELECT
    J.NOME,
    H.IDCLUBE,
    H.DATAFIM
FROM Futebol.Jogador AS J
OUTER APPLY (
    SELECT TOP (1)
        IDCLUBE,
        DATAFIM
    FROM Futebol.Historico
    WHERE IDJOGADOR = J.IDJOGADOR
    ORDER BY DATAFIM DESC, IDHISTORICO DESC
) AS H;


-- APPLY COM FUNCAO QUE DEVOLVE TABELA

SELECT
    C.NOME AS CLUBE,
    J.NOME AS JOGADOR
FROM Futebol.Clube AS C
CROSS APPLY Futebol.fn_JogadoresClube(C.IDCLUBE) AS J;


