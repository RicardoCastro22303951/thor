-- 09. CASE WHEN
-- ============================================================

-- CASE permite devolver valores diferentes
-- dependendo de uma condicao.


-- CLASSIFICAR JOGADORES POR SALARIO

SELECT
    NOME,
    SALARIO,
    CASE
        WHEN SALARIO >= 50000 THEN 'Alto'
        WHEN SALARIO >= 20000 THEN 'Medio'
        ELSE 'Baixo'
    END AS CLASSIFICACAO
FROM Futebol.Jogador;


-- VERIFICAR SE POSSUI CLUBE

SELECT
    NOME,
    CASE
        WHEN IDCLUBE IS NULL THEN 'Sem clube'
        ELSE 'Com clube'
    END AS ESTADO
FROM Futebol.Jogador;


-- CASE SIMPLES

SELECT
    NOME,
    CASE IDCLUBE
        WHEN 1 THEN 'Porto'
        WHEN 2 THEN 'Benfica'
        WHEN 3 THEN 'Sporting'
        ELSE 'Outro'
    END AS CLUBE
FROM Futebol.Jogador;


-- CASE devolve um valor.
-- IF controla a execucao de instrucoes.


-- ============================================================
-- 10. UNION E UNION ALL
-- GitBook: Lesson 04 - GROUP FUNCTIONS AND SET OPERATORS
-- ============================================================

-- UNION combina resultados e elimina duplicados.
-- UNION ALL combina resultados mantendo duplicados.
--
-- As consultas devem ter:
-- 1. O mesmo numero de colunas.
-- 2. Tipos de dados compativeis.
-- 3. Colunas na mesma ordem logica.


-- COMBINAR JOGADORES ATUAIS COM HISTORICO

SELECT
    IDJOGADOR,
    IDCLUBE,
    SALARIO,
    DATAINICIO,
    CAST(NULL AS DATE) AS DATAFIM
FROM Futebol.Jogador

UNION ALL

SELECT
    IDJOGADOR,
    IDCLUBE,
    SALARIO,
    DATAINICIO,
    DATAFIM
FROM Futebol.Historico

ORDER BY IDJOGADOR, DATAINICIO;


-- COMBINAR DATAS COM TEXTO 'ATUAL'
-- E necessario converter a data para VARCHAR.

SELECT
    J.IDJOGADOR,
    J.NOME,
    J.DATAINICIO,
    'Atual' AS DATAFIM
FROM Futebol.Jogador AS J

UNION ALL

SELECT
    H.IDJOGADOR,
    (
        SELECT J.NOME
        FROM Futebol.Jogador AS J
        WHERE J.IDJOGADOR = H.IDJOGADOR
    ),
    H.DATAINICIO,
    CAST(H.DATAFIM AS VARCHAR(12))
FROM Futebol.Historico AS H

ORDER BY NOME, DATAINICIO;


-- HISTORICO COMPLETO COM NOMES DOS CLUBES

SELECT
    J.IDJOGADOR,
    J.NOME,
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = J.IDCLUBE
    ) AS CLUBE,
    J.SALARIO,
    J.DATAINICIO,
    'Atual' AS DATAFIM
FROM Futebol.Jogador AS J

UNION ALL

SELECT
    H.IDJOGADOR,
    (
        SELECT J.NOME
        FROM Futebol.Jogador AS J
        WHERE J.IDJOGADOR = H.IDJOGADOR
    ),
    (
        SELECT C.NOME
        FROM Futebol.Clube AS C
        WHERE C.IDCLUBE = H.IDCLUBE
    ),
    H.SALARIO,
    H.DATAINICIO,
    CAST(H.DATAFIM AS VARCHAR(12))
FROM Futebol.Historico AS H

ORDER BY NOME, DATAINICIO DESC;


-- ORDER BY deve aparecer no final do UNION.
-- Os nomes das colunas resultam do primeiro SELECT.


-- ============================================================
-- 11. INTERSECT E EXCEPT
-- GitBook: Lesson 04 - GROUP FUNCTIONS AND SET OPERATORS
-- ============================================================

-- INTERSECT devolve os valores comuns aos dois resultados.

SELECT IDJOGADOR
FROM Futebol.Jogador

INTERSECT

SELECT IDJOGADOR
FROM Futebol.Historico;


-- EXCEPT devolve os valores do primeiro resultado
-- que nao existem no segundo resultado.

SELECT IDJOGADOR
FROM Futebol.Jogador

EXCEPT

SELECT IDJOGADOR
FROM Futebol.Historico;


-- UNION elimina duplicados.
-- UNION ALL mantem duplicados.
-- INTERSECT devolve valores comuns distintos.
-- EXCEPT devolve valores distintos exclusivos do primeiro.


