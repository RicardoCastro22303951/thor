-- 01. CRIACAO DE ESTRUTURAS DE EXEMPLO
-- GitBook: Lesson 05 - CREATE
-- GitBook: Lesson 06 - CONSTRAINTS
-- GitBook: Lesson 07 - FOREIGN KEYS
-- ============================================================

CREATE SCHEMA Futebol;
GO

CREATE TABLE Futebol.Clube (
    IDCLUBE INT NOT NULL,
    NOME VARCHAR(100) NOT NULL
);

CREATE TABLE Futebol.Jogador (
    IDJOGADOR INT NOT NULL,
    NOME VARCHAR(100) NOT NULL,
    IDCLUBE INT NULL,
    SALARIO DECIMAL(10,2) NOT NULL,
    DATAINICIO DATE NOT NULL
);

CREATE TABLE Futebol.Historico (
    IDHISTORICO INT IDENTITY(1,1) NOT NULL,
    IDJOGADOR INT NOT NULL,
    IDCLUBE INT NULL,
    SALARIO DECIMAL(10,2) NOT NULL,
    DATAINICIO DATE NOT NULL,
    DATAFIM DATE NOT NULL
);


-- PRIMARY KEYS

ALTER TABLE Futebol.Clube
ADD CONSTRAINT PK_CLUBE
PRIMARY KEY (IDCLUBE);

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT PK_JOGADOR
PRIMARY KEY (IDJOGADOR);

ALTER TABLE Futebol.Historico
ADD CONSTRAINT PK_HISTORICO
PRIMARY KEY (IDHISTORICO);


-- FOREIGN KEYS

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT FK_JOGADOR_CLUBE
FOREIGN KEY (IDCLUBE)
REFERENCES Futebol.Clube (IDCLUBE);

ALTER TABLE Futebol.Historico
ADD CONSTRAINT FK_HISTORICO_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR);

ALTER TABLE Futebol.Historico
ADD CONSTRAINT FK_HISTORICO_CLUBE
FOREIGN KEY (IDCLUBE)
REFERENCES Futebol.Clube (IDCLUBE);


-- CHECK

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT CK_SALARIO
CHECK (SALARIO > 0);

ALTER TABLE Futebol.Historico
ADD CONSTRAINT CK_HISTORICO_DATAS
CHECK (DATAFIM >= DATAINICIO);


