-- ============================================================
-- 24. REVERTER ALTERACOES ATRAVES DO HISTORICO
-- ============================================================

-- Recuperar os dados do ultimo registo de historico.
-- Atualizar o jogador com os valores anteriores.
-- Eliminar apenas o registo de historico recuperado.


DECLARE @ID INT = 1;
DECLARE @IDHistorico INT;

BEGIN TRY

    BEGIN TRANSACTION;

    SELECT TOP (1)
        @IDHistorico = IDHISTORICO
    FROM Futebol.Historico
    WHERE IDJOGADOR = @ID
    ORDER BY DATAFIM DESC, IDHISTORICO DESC;


    IF @IDHistorico IS NULL
    BEGIN
        THROW 50003, 'Nao existe historico', 1;
    END;


    UPDATE Futebol.Jogador
    SET
        IDCLUBE = (
            SELECT IDCLUBE
            FROM Futebol.Historico
            WHERE IDHISTORICO = @IDHistorico
        ),
        SALARIO = (
            SELECT SALARIO
            FROM Futebol.Historico
            WHERE IDHISTORICO = @IDHistorico
        ),
        DATAINICIO = (
            SELECT DATAINICIO
            FROM Futebol.Historico
            WHERE IDHISTORICO = @IDHistorico
        )
    WHERE IDJOGADOR = @ID;


    DELETE FROM Futebol.Historico
    WHERE IDHISTORICO = @IDHistorico;

    COMMIT;

END TRY
BEGIN CATCH

    IF @@TRANCOUNT <> 0
    BEGIN
        ROLLBACK;
    END;

    SELECT ERROR_MESSAGE() AS ERRO;

END CATCH;

GO


