-- CRIAR TABELA PARA GUARDAR UMA COPIA DOS JOGADORES

CREATE TABLE Futebol.CopiaJogador (
    IDJOGADOR INT,
    NOME VARCHAR(100),
    SALARIO DECIMAL(10,2)
);


-- INSERIR DADOS DE OUTRA TABELA

INSERT INTO Futebol.CopiaJogador
    (IDJOGADOR, NOME, SALARIO)
SELECT
    IDJOGADOR,
    NOME,
    SALARIO
FROM Futebol.Jogador;


SELECT *
FROM Futebol.CopiaJogador;


-- INSERIR APENAS DADOS QUE RESPEITAM UMA CONDICAO

INSERT INTO Futebol.CopiaJogador
    (IDJOGADOR, NOME, SALARIO)
SELECT
    IDJOGADOR,
    NOME,
    SALARIO
FROM Futebol.Jogador
WHERE SALARIO > 50000;


-- SELECT INTO
-- Cria uma nova tabela com o resultado da consulta.
-- A tabela de destino ainda nao pode existir.

SELECT
    IDJOGADOR,
    NOME,
    SALARIO
INTO Futebol.CopiaSalarios
FROM Futebol.Jogador;


-- SELECT INTO nao copia automaticamente
-- todas as restricoes e indices da tabela original.


