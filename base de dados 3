-- ============================================================
-- 29. INSERTED E DELETED
-- ============================================================

-- INSERTED e DELETED sao tabelas logicas
-- disponibilizadas dentro dos triggers.
--
-- INSERT:
-- INSERTED possui os novos registos.
-- DELETED esta vazia.
--
-- UPDATE:
-- INSERTED possui os valores novos.
-- DELETED possui os valores antigos.
--
-- DELETE:
-- INSERTED esta vazia.
-- DELETED possui os registos eliminados.
--
-- Exemplo de UPDATE:
--
-- Antes:
-- IDJOGADOR = 1
-- SALARIO = 50000
--
-- Depois:
-- IDJOGADOR = 1
-- SALARIO = 60000
--
-- DELETED.SALARIO = 50000
-- INSERTED.SALARIO = 60000
--
-- Um trigger e executado por instrucao,
-- nao necessariamente uma vez por registo.
--
-- INSERTED e DELETED podem possuir varias linhas.
-- Utilizar JOIN, INSERT INTO SELECT e EXISTS
-- para tratar todos os registos afetados.


-- ============================================================
-- 30. TRIGGER DE INSERT
-- ============================================================

-- Criar tabela de auditoria.

CREATE TABLE Futebol.Auditoria (
    IDAUDITORIA INT IDENTITY(1,1) PRIMARY KEY,
    IDJOGADOR INT,
    OPERACAO VARCHAR(20),
    SALARIO_ANTIGO DECIMAL(10,2),
    SALARIO_NOVO DECIMAL(10,2),
    DATAOPERACAO DATETIME2 DEFAULT SYSDATETIME()
);


-- REGISTAR AUTOMATICAMENTE JOGADORES INSERIDOS

GO

CREATE TRIGGER Futebol.trg_InsertJogador
ON Futebol.Jogador
AFTER INSERT
AS
BEGIN

    SET NOCOUNT ON;

    INSERT INTO Futebol.Auditoria
        (IDJOGADOR, OPERACAO, SALARIO_NOVO)
    SELECT
        IDJOGADOR,
        'INSERT',
        SALARIO
    FROM inserted;

END;

GO


