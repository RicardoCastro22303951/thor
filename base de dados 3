-- ============================================================
-- 15. IF E ELSE
-- T-SQL - Estruturas de controlo
-- ============================================================

-- IF executa instrucoes se a condicao for verdadeira.
-- ELSE executa instrucoes quando a condicao nao e verdadeira.


DECLARE @Numero INT = 10;

IF @Numero > 5
BEGIN
    PRINT 'Maior que cinco';
END
ELSE
BEGIN
    PRINT 'Menor ou igual a cinco';
END;

GO


-- VERIFICAR SE UM JOGADOR EXISTE

