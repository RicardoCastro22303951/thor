-- ============================================================
-- 23. REGISTO DE HISTORICO
-- ============================================================

-- Quando um jogador muda de clube:
--
-- 1. Guardar os dados atuais na tabela Historico.
-- 2. Alterar os dados atuais do jogador.
-- 3. Atualizar a data de inicio.
-- 4. Confirmar as operacoes numa transacao.


DECLARE @ID INT = 1;
DECLARE @NovoClube INT = 3;
DECLARE @DataMudanca DATE = CAST(GETDATE() AS DATE);

BEGIN TRY

    BEGIN TRANSACTION;

    IF NOT EXISTS (
        SELECT 1
        FROM Futebol.Jogador
        WHERE IDJOGADOR = @ID
    )
    BEGIN
        THROW 50001, 'Jogador inexistente', 1;
    END;

    IF NOT EXISTS (
        SELECT 1
        FROM Futebol.Clube
        WHERE IDCLUBE = @NovoClube
    )
    BEGIN
        THROW 50002, 'Clube inexistente', 1;
    END;


    -- Guardar os dados antigos.

    INSERT INTO Futebol.Historico
        (IDJOGADOR, IDCLUBE, SALARIO, DATAINICIO, DATAFIM)
    SELECT
        IDJOGADOR,
        IDCLUBE,
        SALARIO,
        DATAINICIO,
        @DataMudanca
    FROM Futebol.Jogador
    WHERE IDJOGADOR = @ID;


    -- Atualizar os dados atuais.

    UPDATE Futebol.Jogador
    SET
        IDCLUBE = @NovoClube,
        DATAINICIO = @DataMudanca
    WHERE IDJOGADOR = @ID;

    COMMIT;

END TRY
BEGIN CATCH

    IF @@TRANCOUNT <> 0
    BEGIN
        ROLLBACK;
    END;

    SELECT
        ERROR_NUMBER() AS NUMERO,
        ERROR_LINE() AS LINHA,
        ERROR_MESSAGE() AS ERRO;

END CATCH;

GO


