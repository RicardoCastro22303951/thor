SELECT *
FROM Futebol.Auditoria;


-- ============================================================
-- 31. TRIGGER DE UPDATE
-- ============================================================

-- Registar automaticamente alteracoes de salario.
-- DELETED possui o salario antigo.
-- INSERTED possui o salario novo.


GO

CREATE TRIGGER Futebol.trg_UpdateSalario
ON Futebol.Jogador
AFTER UPDATE
AS
BEGIN

    SET NOCOUNT ON;

    INSERT INTO Futebol.Auditoria
        (
            IDJOGADOR,
            OPERACAO,
            SALARIO_ANTIGO,
            SALARIO_NOVO
        )
    SELECT
        I.IDJOGADOR,
        'UPDATE',
        D.SALARIO,
        I.SALARIO
    FROM inserted AS I
    INNER JOIN deleted AS D
    ON I.IDJOGADOR = D.IDJOGADOR
    WHERE I.SALARIO <> D.SALARIO;

END;

GO


