-- 4.1 REMOVER A CHAVE ESTRANGEIRA ANTERIOR
-- GitBook: Lesson 07 - Applying references with foreign keys
--
-- Nao podemos alterar diretamente uma restricao existente.
-- Temos de eliminar a restricao e voltar a cria-la.

ALTER TABLE Futebol.Contrato
DROP CONSTRAINT FK_JOGADOR;


-- 4.2 CRIAR A CHAVE ESTRANGEIRA COM ON UPDATE CASCADE
--
-- ON UPDATE CASCADE permite que a alteracao da chave
-- primaria seja automaticamente propagada para as
-- chaves estrangeiras associadas.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT FK_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR)
ON UPDATE CASCADE;


-- 4.3 ALTERAR O IDENTIFICADOR DO JOGADOR

UPDATE Futebol.Jogador
SET IDJOGADOR = 20
WHERE IDJOGADOR = 2;


-- ANTES:
-- Jogador Messi: IDJOGADOR = 2
-- Contrato 2: IDJOGADOR = 2
-- Contrato 3: IDJOGADOR = 2
--
-- DEPOIS:
-- Jogador Messi: IDJOGADOR = 20
-- Contrato 2: IDJOGADOR = 20
-- Contrato 3: IDJOGADOR = 20
--
-- Os contratos sao atualizados automaticamente.


-- 4.4 LISTAR O JOGADOR ALTERADO

SELECT *
FROM Futebol.Jogador
