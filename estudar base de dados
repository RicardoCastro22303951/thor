
-- Pretende-se criar uma base de dados para registar jogadores
-- de futebol e os respetivos contratos com clubes.

-- Um jogador pode ter varios contratos, mas com datas de
-- inicio diferentes.

-- Cada jogador possui um identificador unico, nome,
-- email unico e data de nascimento.

-- Cada contrato possui um identificador unico, jogador
-- associado, nome do clube, data de inicio e salario.

-- Todos os campos iniciais sao obrigatorios.
-- O salario deve ser superior a zero.


-- ============================================================
-- QUESTAO 1 - CRIACAO DO MODELO (3 VALORES)
-- ============================================================

-- ENUNCIADO:
-- (2) Cria o modelo com as tabelas indicadas num novo schema.
-- (1) Demonstra que as entidades foram criadas.


-- 1.1 CRIAR SCHEMA
-- GitBook: Lesson 05 - CREATE

CREATE SCHEMA Futebol;
GO


-- 1.2 CRIAR TABELA JOGADOR
-- GitBook: Lesson 05 - CREATE / Data types

CREATE TABLE Futebol.Jogador (
    IDJOGADOR INT NOT NULL,
    NOME VARCHAR(80) NOT NULL,
    EMAIL VARCHAR(100) NOT NULL,
    DATADENASCIMENTO DATE NOT NULL
);


-- 1.3 CRIAR TABELA CONTRATO

CREATE TABLE Futebol.Contrato (
    IDCONTRATO INT NOT NULL,
    IDJOGADOR INT NOT NULL,
    CLUBE VARCHAR(80) NOT NULL,
    DATAINICIO DATE NOT NULL,
    SALARIO DECIMAL(10,2) NOT NULL
);


-- 1.4 ADICIONAR CHAVES PRIMARIAS
-- GitBook: Lesson 06 - PRIMARY KEY
-- PRIMARY KEY identifica unicamente cada registo.
-- Nao permite valores repetidos nem NULL.

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT PK_JOGADOR
PRIMARY KEY (IDJOGADOR);

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT PK_CONTRATO
PRIMARY KEY (IDCONTRATO);


-- 1.5 ADICIONAR CHAVE ESTRANGEIRA
-- GitBook: Lesson 07 - Applying references with foreign keys
-- FOREIGN KEY garante que o jogador associado existe.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT FK_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR);


-- 1.6 GARANTIR QUE O EMAIL E UNICO
-- GitBook: Lesson 06 - UNIQUE and alternate keys

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT UQ_EMAIL
UNIQUE (EMAIL);


-- 1.7 GARANTIR DATAS DE INICIO DIFERENTES POR JOGADOR
-- UNIQUE composta impede a repeticao da combinacao
-- de duas ou mais colunas.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT UQ_CONTRATO
UNIQUE (IDJOGADOR, DATAINICIO);


-- 1.8 GARANTIR QUE O SALARIO E POSITIVO
-- GitBook: Lesson 06 - CHECK
-- CHECK garante que uma determinada condicao e respeitada.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT CK_SALARIO
CHECK (SALARIO > 0);


-- 1.9 DEMONSTRAR QUE AS TABELAS FORAM CRIADAS

SELECT *
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'Futebol';


-- Demonstrar a estrutura das tabelas.

SELECT *
