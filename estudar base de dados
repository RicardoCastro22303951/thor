WHERE TABLE_SCHEMA = 'Futebol';


-- Demonstrar a estrutura de uma tabela especifica.

SELECT *
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'Futebol'
AND TABLE_NAME = 'Jogador';


-- ============================================================
-- QUESTAO 2 - INSERCAO E CONSULTA DE DADOS (5 VALORES)
-- ============================================================

-- ENUNCIADO:
-- (2) Insere registos nas tabelas, garantindo que existe
-- um jogador com um contrato, outro com dois contratos
-- e outro sem qualquer contrato.
--
-- (1) Lista todos os dados inseridos.
--
-- (1) Lista todos os contratos, indicando o nome do clube,
-- salario e nome do jogador, sem mostrar identificadores.
--
-- (1) Inclui na lista anterior os jogadores sem contratos.


-- 2.1 INSERIR JOGADORES
-- As datas e os textos devem estar entre aspas simples.
-- Os numeros nao precisam de aspas.
-- O numero de valores deve corresponder ao numero de colunas.

INSERT INTO Futebol.Jogador
    (IDJOGADOR, NOME, EMAIL, DATADENASCIMENTO)
VALUES
    (1, 'Ronaldo', 'ronaldo@gmail.com', '1985-02-05'),
    (2, 'Messi', 'messi@gmail.com', '1987-06-24'),
    (3, 'Pepe', 'pepe@gmail.com', '1983-02-26');


-- 2.2 INSERIR CONTRATOS
-- Inserir primeiro os jogadores e depois os contratos,
-- porque os contratos dependem dos jogadores.

INSERT INTO Futebol.Contrato
    (IDCONTRATO, IDJOGADOR, CLUBE, DATAINICIO, SALARIO)
VALUES
    (1, 1, 'Real Madrid', '2009-07-01', 50000),
    (2, 2, 'Barcelona', '2004-07-01', 40000),
    (3, 2, 'PSG', '2021-08-10', 60000);


-- RESULTADO:
-- Ronaldo: 1 contrato.
-- Messi: 2 contratos.
-- Pepe: 0 contratos.


-- 2.3 LISTAR TODOS OS DADOS INSERIDOS

SELECT *
FROM Futebol.Jogador;

SELECT *
FROM Futebol.Contrato;


-- 2.4 LISTAR TODOS OS CONTRATOS SEM IDENTIFICADORES
-- GitBook: Lesson 08 - Horizontal join syntax
-- INNER JOIN apresenta apenas registos com correspondencia
-- nas duas tabelas.

SELECT
    C.CLUBE,
    C.SALARIO,
    J.NOME
FROM Futebol.Contrato AS C
INNER JOIN Futebol.Jogador AS J
ON C.IDJOGADOR = J.IDJOGADOR;


-- RESULTADO:
-- Real Madrid | 50000 | Ronaldo
-- Barcelona   | 40000 | Messi
-- PSG         | 60000 | Messi


-- 2.5 INCLUIR JOGADORES SEM CONTRATOS
-- LEFT JOIN apresenta todos os registos da tabela
-- que esta do lado esquerdo, mesmo sem correspondencia.

SELECT
    C.CLUBE,
    C.SALARIO,
    J.NOME
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;


-- RESULTADO:
-- Real Madrid | 50000 | Ronaldo
-- Barcelona   | 40000 | Messi
-- PSG         | 60000 | Messi
-- NULL        | NULL  | Pepe

-- REGRA:
-- Colocar no FROM a tabela da qual queremos manter
-- todos os registos quando utilizamos LEFT JOIN.


-- ============================================================
-- QUESTAO 3 - ALTERACAO DA ESTRUTURA (4 VALORES)
-- ============================================================

-- ENUNCIADO:
-- (2) Apos as insercoes, altera a tabela adequada para
-- incluir a data de fim do contrato, garantindo que
-- cada contrato tem uma duracao minima de um mes.
-- Altera pelo menos um contrato para registar a conclusao.
--
-- (1) Lista todos os dados da tabela alterada.
--
-- (1) Lista apenas os contratos terminados.


-- 3.1 ADICIONAR COLUNA DATAFIM
-- GitBook: Lesson 05 - ALTER
-- A coluna deve aceitar NULL porque podem existir
-- contratos que ainda nao terminaram.

ALTER TABLE Futebol.Contrato
ADD DATAFIM DATE NULL;
GO


-- 3.2 GARANTIR DURACAO MINIMA DE UM MES
-- GitBook: Lesson 06 - CHECK
-- DATEADD adiciona um intervalo de tempo a uma data.
--
-- DATEADD(MONTH, 1, DATAINICIO)
-- Adiciona um mes a data de inicio.
--
-- A restricao CHECK aceita NULL neste caso.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT CK_DURACAO
CHECK (
    DATAFIM >= DATEADD(MONTH, 1, DATAINICIO)
);


-- EXEMPLOS:
-- Inicio: 2024-01-01 | Fim: 2024-01-15 | INVALIDO
-- Inicio: 2024-01-01 | Fim: 2024-02-01 | VALIDO
-- Inicio: 2024-01-01 | Fim: 2024-03-01 | VALIDO
-- Inicio: 2024-01-01 | Fim: NULL       | VALIDO


-- 3.3 REGISTAR A CONCLUSAO DE UM CONTRATO
-- UPDATE altera registos existentes.
-- SET indica o novo valor.
-- WHERE identifica os registos a alterar.

UPDATE Futebol.Contrato
SET DATAFIM = '2018-07-01'
WHERE IDCONTRATO = 1;


-- 3.4 LISTAR TODOS OS DADOS DA TABELA ALTERADA

SELECT *
FROM Futebol.Contrato;


-- 3.5 LISTAR APENAS OS CONTRATOS TERMINADOS
-- Neste modelo, DATAFIM preenchida significa concluido.

SELECT *
FROM Futebol.Contrato
WHERE DATAFIM IS NOT NULL;


