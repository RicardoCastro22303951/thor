-- ============================================================
-- 02. CRIACAO DE TABELAS
-- GitBook: Lesson 05 - CREATE
-- ============================================================

CREATE TABLE Futebol.Jogador (
    IDJOGADOR INT NOT NULL,
    NOME VARCHAR(80) NOT NULL,
    EMAIL VARCHAR(100) NOT NULL,
    DATADENASCIMENTO DATE NOT NULL
);

CREATE TABLE Futebol.Contrato (
    IDCONTRATO INT NOT NULL,
    IDJOGADOR INT NOT NULL,
    CLUBE VARCHAR(80) NOT NULL,
    DATAINICIO DATE NOT NULL,
    SALARIO DECIMAL(10,2) NOT NULL
);

-- NOT NULL: campo obrigatorio.
-- NULL: campo opcional.


-- ============================================================
-- 03. TIPOS DE DADOS
-- GitBook: Lesson 05 - Data types
-- ============================================================

-- INT           : Numero inteiro.
-- SMALLINT      : Numero inteiro de menor capacidade.
-- BIGINT        : Numero inteiro de maior capacidade.
-- DECIMAL(10,2) : Numero com 10 digitos, 2 decimais.
-- NUMERIC(10,2) : Equivalente a DECIMAL.
-- FLOAT         : Numero aproximado.
-- VARCHAR(80)   : Texto de tamanho variavel.
-- CHAR(10)      : Texto de tamanho fixo.
-- NVARCHAR(80)  : Texto Unicode.
-- DATE          : Data.
-- DATETIME      : Data e hora.
-- DATETIME2     : Data e hora com maior precisao.
-- BIT           : 0 ou 1, podendo aceitar NULL.

-- Exemplo de coluna com identificador automatico:
-- ID INT IDENTITY(1,1) PRIMARY KEY

-- IDENTITY(1,1):
-- Primeiro valor: 1.
-- Incremento: 1.


-- ============================================================
-- 04. PRIMARY KEY
-- GitBook: Lesson 06 - PRIMARY KEY
-- ============================================================

-- Identifica unicamente cada registo.
-- Nao permite valores repetidos nem NULL.
-- Cada tabela possui no maximo uma PRIMARY KEY.

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT PK_JOGADOR
PRIMARY KEY (IDJOGADOR);

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT PK_CONTRATO
PRIMARY KEY (IDCONTRATO);


-- PRIMARY KEY COMPOSTA
-- A combinacao das colunas deve ser unica.
-- Exemplo alternativo:

/*
