-- ============================================================
-- 14. FUNCOES DE DATAS
-- ============================================================

-- GETDATE()
-- Obter data e hora atuais.

SELECT GETDATE();


-- CAST
-- Converter um tipo de dados.

SELECT CAST(GETDATE() AS DATE);


-- DATEADD
-- Adicionar tempo a uma data.

SELECT DATEADD(DAY, 10, '2024-01-01');

SELECT DATEADD(MONTH, 1, '2024-01-01');

SELECT DATEADD(YEAR, 1, '2024-01-01');


-- SUBTRAIR TEMPO

SELECT DATEADD(MONTH, -1, '2024-02-01');


-- DATEDIFF
-- Contar fronteiras de intervalos entre datas.

SELECT DATEDIFF(DAY, '2024-01-01', '2024-02-01');

SELECT DATEDIFF(MONTH, '2024-01-01', '2024-02-01');

SELECT DATEDIFF(YEAR, '2020-01-01', '2024-01-01');


-- OBTER ANO, MES E DIA

SELECT
    YEAR(DATAINICIO),
    MONTH(DATAINICIO),
    DAY(DATAINICIO)
FROM Futebol.Contrato;


-- CHECK COM DURACAO MINIMA DE UM MES

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT CK_DURACAO
CHECK (
    DATAFIM >= DATEADD(MONTH, 1, DATAINICIO)
);


-- EXEMPLOS:
-- Inicio: 2024-01-01 | Fim: 2024-01-15 | INVALIDO
-- Inicio: 2024-01-01 | Fim: 2024-02-01 | VALIDO
-- Inicio: 2024-01-01 | Fim: 2024-03-01 | VALIDO
-- Inicio: 2024-01-01 | Fim: NULL       | VALIDO


