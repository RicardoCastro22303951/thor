ADD CONSTRAINT FK_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR)
ON DELETE SET DEFAULT;
*/


-- IMPORTANTE:
-- Para alterar uma FOREIGN KEY existente,
-- eliminar a restricao e voltar a cria-la.
--
-- Nao existe ALTER TABLE UPDATE CONSTRAINT.
--
-- SET NULL e SET DEFAULT tambem devem respeitar
-- as restantes restricoes da tabela, como UNIQUE.


-- ============================================================
-- 17. FUNCOES DE AGREGACAO
-- GitBook: Lesson 04 - GROUP FUNCTIONS AND SET OPERATORS
-- ============================================================

-- COUNT : Contar registos.
-- SUM   : Somar valores.
-- AVG   : Calcular media.
-- MAX   : Obter maior valor.
-- MIN   : Obter menor valor.


-- CONTAR TODOS OS JOGADORES

SELECT COUNT(*) AS TOTAL_JOGADORES
FROM Futebol.Jogador;


-- CONTAR TODOS OS CONTRATOS

SELECT COUNT(*) AS TOTAL_CONTRATOS
FROM Futebol.Contrato;


-- CONTAR JOGADORES DIFERENTES COM CONTRATOS

SELECT COUNT(DISTINCT IDJOGADOR)
FROM Futebol.Contrato;


-- CALCULAR SALARIO TOTAL

SELECT SUM(SALARIO) AS SALARIO_TOTAL
FROM Futebol.Contrato;


-- CALCULAR SALARIO MEDIO

SELECT AVG(SALARIO) AS SALARIO_MEDIO
FROM Futebol.Contrato;


-- OBTER MAIOR SALARIO

SELECT MAX(SALARIO) AS MAIOR_SALARIO
FROM Futebol.Contrato;


-- OBTER MENOR SALARIO

SELECT MIN(SALARIO) AS MENOR_SALARIO
FROM Futebol.Contrato;


-- GROUP BY
-- Agrupa registos para aplicar funcoes de agregacao.


-- CONTAR CONTRATOS POR JOGADOR

SELECT
    IDJOGADOR,
    COUNT(*) AS TOTAL_CONTRATOS
FROM Futebol.Contrato
GROUP BY IDJOGADOR;


-- CALCULAR SALARIO MEDIO POR CLUBE

SELECT
    CLUBE,
    AVG(SALARIO) AS SALARIO_MEDIO
FROM Futebol.Contrato
GROUP BY CLUBE;


-- CONTAR CONTRATOS POR JOGADOR, INCLUINDO ZERO

SELECT
    J.IDJOGADOR,
    J.NOME,
    COUNT(C.IDCONTRATO) AS TOTAL_CONTRATOS
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR
GROUP BY J.IDJOGADOR, J.NOME;


-- COUNT(C.IDCONTRATO) ignora os valores NULL.
-- COUNT(*) contaria tambem a linha do jogador sem contrato.


-- HAVING
-- Filtra grupos depois do GROUP BY.

SELECT
    IDJOGADOR,
    COUNT(*) AS TOTAL_CONTRATOS
FROM Futebol.Contrato
GROUP BY IDJOGADOR
HAVING COUNT(*) > 1;


-- WHERE E HAVING

SELECT
    CLUBE,
    AVG(SALARIO) AS SALARIO_MEDIO
FROM Futebol.Contrato
WHERE SALARIO > 1000
GROUP BY CLUBE
HAVING AVG(SALARIO) > 2000;


-- WHERE filtra registos antes do agrupamento.
-- HAVING filtra grupos depois do agrupamento.


