-- Elimina todos os registos, mantendo a estrutura.
-- Nao permite WHERE.
-- Possui restricoes quando a tabela e referenciada
-- por uma FOREIGN KEY.

-- DROP TABLE:
-- Elimina os registos e a estrutura da tabela.

-- DROP SCHEMA:
-- Elimina um schema vazio.


-- TRUNCATE

/*
TRUNCATE TABLE Futebol.Contrato;
*/


