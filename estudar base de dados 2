-- 11. SELECT E WHERE
-- ============================================================

-- LISTAR TODOS OS REGISTOS

SELECT *
FROM Futebol.Jogador;

SELECT *
FROM Futebol.Contrato;


-- LISTAR APENAS DETERMINADAS COLUNAS

SELECT NOME, EMAIL
FROM Futebol.Jogador;


-- FILTRAR POR IDENTIFICADOR

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR = 1;


-- FILTRAR POR SALARIO

SELECT *
FROM Futebol.Contrato
WHERE SALARIO > 1000;


-- OPERADORES DE COMPARACAO

-- =   Igual
-- <>  Diferente
-- >   Maior
-- <   Menor
-- >=  Maior ou igual
-- <=  Menor ou igual


-- AND
-- As duas condicoes devem ser verdadeiras.

SELECT *
FROM Futebol.Contrato
WHERE SALARIO > 1000
AND CLUBE = 'Porto';


-- OR
-- Pelo menos uma condicao deve ser verdadeira.

SELECT *
FROM Futebol.Contrato
WHERE CLUBE = 'Porto'
OR CLUBE = 'Benfica';


-- BETWEEN
-- Intervalo inclusivo.

SELECT *
FROM Futebol.Contrato
WHERE SALARIO BETWEEN 1000 AND 5000;


-- IN
-- Verificar se um valor pertence a uma lista.

SELECT *
FROM Futebol.Contrato
WHERE CLUBE IN ('Porto', 'Benfica', 'Sporting');


-- NOT IN
-- Verificar se um valor nao pertence a uma lista.

SELECT *
FROM Futebol.Contrato
WHERE CLUBE NOT IN ('Porto', 'Benfica');


-- LIKE
-- Procurar padroes em texto.
-- % representa zero ou mais caracteres.
-- _ representa exatamente um caracter.

SELECT *
FROM Futebol.Jogador
WHERE NOME LIKE 'R%';


-- Nomes que terminam em O.

SELECT *
FROM Futebol.Jogador
WHERE NOME LIKE '%O';


-- Nomes que contem A.

SELECT *
FROM Futebol.Jogador
WHERE NOME LIKE '%A%';


-- IS NULL

SELECT *
FROM Futebol.Jogador
WHERE EMAIL IS NULL;


-- IS NOT NULL

SELECT *
FROM Futebol.Jogador
WHERE EMAIL IS NOT NULL;


-- Nunca utilizar = NULL ou <> NULL.


-- ORDER BY ASC
-- Ordenacao crescente.

SELECT *
FROM Futebol.Contrato
ORDER BY SALARIO ASC;


-- ORDER BY DESC
-- Ordenacao decrescente.

SELECT *
FROM Futebol.Contrato
ORDER BY SALARIO DESC;


-- ORDENAR POR VARIAS COLUNAS

SELECT *
FROM Futebol.Contrato
ORDER BY SALARIO DESC, CLUBE ASC;


-- TOP
-- Selecionar os primeiros registos.

SELECT TOP 3 *
FROM Futebol.Contrato
ORDER BY SALARIO DESC;


-- DISTINCT
-- Eliminar repeticoes do resultado.

SELECT DISTINCT CLUBE
FROM Futebol.Contrato;


-- AS
-- Criar um alias para uma coluna.

SELECT NOME AS NOME_JOGADOR
FROM Futebol.Jogador;


