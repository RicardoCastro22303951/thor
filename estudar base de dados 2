-- 20. VIEWS
-- GitBook: Lesson 05 - Views
-- ============================================================

-- Uma VIEW representa uma consulta guardada.
-- CREATE VIEW deve iniciar um batch.

GO

CREATE VIEW Futebol.vw_Contratos
AS
SELECT
    J.NOME,
    C.CLUBE,
    C.SALARIO
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;

GO


-- CONSULTAR UMA VIEW

SELECT *
FROM Futebol.vw_Contratos;


-- CONSULTAR UMA VIEW COM WHERE

SELECT *
FROM Futebol.vw_Contratos
WHERE SALARIO > 1000;


-- ELIMINAR UMA VIEW

DROP VIEW Futebol.vw_Contratos;


