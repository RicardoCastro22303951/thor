-- ============================================================
-- 05. FOREIGN KEY
-- GitBook: Lesson 07 - Applying references with foreign keys
-- ============================================================

-- FOREIGN KEY garante a integridade referencial.
-- A coluna referenciada deve possuir uma chave adequada,
-- como PRIMARY KEY ou UNIQUE.
-- Os tipos de dados devem ser compativeis.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT FK_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR);


-- SINTAXE GERAL:

/*
ALTER TABLE schema.tabela_dependente
ADD CONSTRAINT nome_restricao
FOREIGN KEY (coluna_dependente)
REFERENCES schema.tabela_principal (coluna_principal);
*/


-- ELIMINAR FOREIGN KEY

/*
ALTER TABLE Futebol.Contrato
DROP CONSTRAINT FK_JOGADOR;
*/


-- ============================================================
-- 06. UNIQUE
-- GitBook: Lesson 06 - UNIQUE and alternate keys
-- ============================================================

-- UNIQUE impede valores repetidos.
-- Uma tabela pode possuir varias restricoes UNIQUE.


-- UNIQUE SIMPLES
-- Impedir emails repetidos.

ALTER TABLE Futebol.Jogador
ADD CONSTRAINT UQ_EMAIL
UNIQUE (EMAIL);


-- UNIQUE COMPOSTA
-- Impedir combinacoes repetidas de jogador e data de inicio.
-- Um jogador pode possuir varios contratos,
-- desde que as datas de inicio sejam diferentes.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT UQ_CONTRATO
UNIQUE (IDJOGADOR, DATAINICIO);


-- ELIMINAR UNIQUE

