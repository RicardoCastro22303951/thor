-- CALCULAR DURACAO DOS CONTRATOS EM DIAS

SELECT
    IDCONTRATO,
    DATEDIFF(DAY, DATAINICIO, DATAFIM) AS DURACAO_DIAS
FROM Futebol.Contrato
WHERE DATAFIM IS NOT NULL;


-- IMPORTANTE:
-- DATEDIFF(MONTH, DATAINICIO, DATAFIM) >= 1
-- nao garante necessariamente um mes completo.
