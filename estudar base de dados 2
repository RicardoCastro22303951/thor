-- 12. JOIN
-- GitBook: Lesson 08 - Horizontal join syntax
-- ============================================================

-- INNER JOIN
-- Apresenta apenas registos com correspondencia
-- nas duas tabelas.

SELECT
    J.NOME,
    C.CLUBE,
    C.SALARIO
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;


-- RESULTADO:
-- Ronaldo | Real Madrid | 50000
-- Messi   | Barcelona   | 40000
-- Messi   | PSG         | 60000


-- LEFT JOIN
-- Apresenta todos os registos da tabela esquerda,
-- mesmo quando nao existe correspondencia.

SELECT
    J.NOME,
    C.CLUBE,
    C.SALARIO
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;


-- RESULTADO:
-- Ronaldo | Real Madrid | 50000
-- Messi   | Barcelona   | 40000
-- Messi   | PSG         | 60000
-- Pepe    | NULL        | NULL


-- RIGHT JOIN
-- Apresenta todos os registos da tabela direita.

SELECT
    J.NOME,
    C.CLUBE,
    C.SALARIO
FROM Futebol.Contrato AS C
RIGHT JOIN Futebol.Jogador AS J
ON C.IDJOGADOR = J.IDJOGADOR;


-- FULL OUTER JOIN
-- Apresenta todos os registos das duas tabelas,
-- mesmo quando nao existe correspondencia.

SELECT
    J.NOME,
    C.CLUBE,
    C.SALARIO
FROM Futebol.Jogador AS J
FULL OUTER JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;


-- CROSS JOIN
-- Todas as combinacoes possiveis entre as tabelas.

SELECT J.NOME, C.CLUBE
FROM Futebol.Jogador AS J
CROSS JOIN Futebol.Contrato AS C;


-- LISTAR APENAS JOGADORES SEM CONTRATOS

SELECT J.NOME
FROM Futebol.Jogador AS J
LEFT JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR
WHERE C.IDCONTRATO IS NULL;


-- UTILIZAR ALIASES NAS COLUNAS

SELECT
    J.NOME AS NOME_JOGADOR,
    C.CLUBE AS NOME_CLUBE,
    C.SALARIO AS SALARIO_MENSAL
FROM Futebol.Jogador AS J
INNER JOIN Futebol.Contrato AS C
ON J.IDJOGADOR = C.IDJOGADOR;


-- REGRA DO LEFT JOIN:
-- Colocar no FROM a tabela da qual queremos manter
-- todos os registos.


