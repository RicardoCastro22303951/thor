-- ============================================================
-- 22. SUBQUERIES
-- ============================================================

-- Uma subquery e uma consulta dentro de outra consulta.


-- LISTAR JOGADORES COM CONTRATOS

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR IN (
    SELECT IDJOGADOR
    FROM Futebol.Contrato
);


-- LISTAR JOGADORES SEM CONTRATOS

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR NOT IN (
    SELECT IDJOGADOR
    FROM Futebol.Contrato
);


-- NOT IN pode produzir resultados inesperados
-- quando a subquery devolve valores NULL.


-- EXISTS

SELECT *
FROM Futebol.Jogador AS J
WHERE EXISTS (
    SELECT 1
    FROM Futebol.Contrato AS C
    WHERE C.IDJOGADOR = J.IDJOGADOR
);


-- NOT EXISTS

SELECT *
FROM Futebol.Jogador AS J
WHERE NOT EXISTS (
    SELECT 1
    FROM Futebol.Contrato AS C
    WHERE C.IDJOGADOR = J.IDJOGADOR
);


-- CONTRATOS COM SALARIO SUPERIOR A MEDIA

SELECT *
FROM Futebol.Contrato
WHERE SALARIO > (
    SELECT AVG(SALARIO)
    FROM Futebol.Contrato
);


-- SUBQUERY NO SELECT
-- Obter o nome do jogador associado ao contrato.

SELECT
    C.CLUBE,
    C.SALARIO,
    (
        SELECT J.NOME
        FROM Futebol.Jogador AS J
        WHERE J.IDJOGADOR = C.IDJOGADOR
    ) AS NOME_JOGADOR
FROM Futebol.Contrato AS C;


-- ============================================================
-- 23. SET OPERATORS
-- GitBook: Lesson 04 - GROUP FUNCTIONS AND SET OPERATORS
-- ============================================================

-- UNION:
-- Combina resultados e elimina repeticoes.

-- UNION ALL:
-- Combina resultados mantendo repeticoes.

-- INTERSECT:
-- Apresenta valores comuns aos dois resultados.

-- EXCEPT:
-- Apresenta valores do primeiro resultado que
-- nao existem no segundo resultado.

-- As consultas devem possuir o mesmo numero de colunas
-- e tipos de dados compativeis.


-- UNION

SELECT IDJOGADOR
FROM Futebol.Jogador

UNION

SELECT IDJOGADOR
FROM Futebol.Contrato;


-- UNION ALL

SELECT IDJOGADOR
FROM Futebol.Jogador

UNION ALL

SELECT IDJOGADOR
FROM Futebol.Contrato;


-- INTERSECT
-- Jogadores que possuem contratos.

SELECT IDJOGADOR
FROM Futebol.Jogador

INTERSECT

SELECT IDJOGADOR
FROM Futebol.Contrato;


-- EXCEPT
-- Jogadores que nao possuem contratos.

SELECT IDJOGADOR
FROM Futebol.Jogador

EXCEPT

SELECT IDJOGADOR
FROM Futebol.Contrato;


