-- ============================================================
-- 16. INTEGRIDADE REFERENCIAL
-- GitBook: Lesson 07 - Applying references with foreign keys
-- ============================================================

-- NO ACTION:
-- Comportamento por defeito.
-- Impede alteracoes que violem a integridade referencial.

-- CASCADE:
-- Propaga automaticamente alteracoes ou eliminacoes.

-- SET NULL:
-- Coloca a referencia a NULL.
-- A coluna deve aceitar NULL.

-- SET DEFAULT:
-- Coloca a referencia no valor por defeito.
-- O valor deve respeitar a integridade referencial.


-- ON UPDATE CASCADE

-- Primeiro eliminar a FOREIGN KEY existente.

ALTER TABLE Futebol.Contrato
DROP CONSTRAINT FK_JOGADOR;


-- Criar novamente a FOREIGN KEY com ON UPDATE CASCADE.

ALTER TABLE Futebol.Contrato
ADD CONSTRAINT FK_JOGADOR
FOREIGN KEY (IDJOGADOR)
REFERENCES Futebol.Jogador (IDJOGADOR)
ON UPDATE CASCADE;


-- Alterar o identificador de um jogador.

UPDATE Futebol.Jogador
SET IDJOGADOR = 20
WHERE IDJOGADOR = 2;


-- Os contratos associados passam automaticamente
-- de IDJOGADOR = 2 para IDJOGADOR = 20.


-- Consultar o jogador alterado.

SELECT *
FROM Futebol.Jogador
WHERE IDJOGADOR = 20;


-- Consultar os contratos associados.

SELECT *
FROM Futebol.Contrato
WHERE IDJOGADOR = 20;


